<launch>
      <!-- <node pkg="bridge_px4" type="gcs_megamodel.py" name ="gcs" output="screen">
            <param name="hold" value="0"/>
            <param name="laps" value="1"/>
      </node> -->
      <node pkg="bridge_px4" type="gcs.py" name ="gcs" output="screen">
            <param name="hold" value="0"/>
            <param name="laps" value="1"/>
      </node>

      <node pkg="bridge_px4" type="gcs_growth.py" name ="gcs_growth" output="screen"/>
      <node pkg="bridge_px4" type="gcs_pressure.py" name ="gcs_pressure" output="screen"/>

      <node pkg="rosbag" type="record" name="rosbag_record_gcs"
            args="/drone5/mavros/vision_pose/pose 
                  /drone5/mavros/local_position/pose
                  /drone5/mavros/setpoint_position/local
                  /drone5/setpoint/position
                  /drone5/setpoint/attitude
                  /vrpn_client_node/tip/pose
                  /drone5/mavros/imu/data
                  /gcs/setpoint/position
                  /gcs/setpoint/attitude
                  /vine_pressure
                  /pressure_cmd"/>
</launch>